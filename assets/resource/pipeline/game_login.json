{
    "GameLoginStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmRunWithRecovery",
                "custom_action_param": {
                    "entry": "GameLoginStartAttempt",
                    "label": "启动游戏"
                }
            }
        }
    },
    "GameLoginStartAttempt": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.pinkcore.tkfm"
            }
        },
        "next": [
            "GameLoginLaunch"
        ]
    },
    "GameLoginLaunch": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.pinkcore.tkfm"
            }
        },
        "next": [
            "GameLoginDispatch"
        ]
    },
    "GameLoginDispatch": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 360000,
        "next": [
            "[JumpBack]GameLoginReconnect",
            "GameLoginReconnectExhausted",
            "[JumpBack]GameSkipStartupAnimation",
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]GameWaitResourceCheck",
            "GameCloseGift",
            "[JumpBack]GameCloseAnnouncement",
            "[JumpBack]GameCloseSignIn",
            "[JumpBack]GameTapTitleScreen",
            "[JumpBack]GameLoginWaitForAdvertisement",
            "GameLoginAdvertisementMissing",
            "[JumpBack]GameLoginWaitTapScreen"
        ],
        "on_error": [
            "GameLoginStopAfterTimeout"
        ],
        "focus": {
            "Node.Action.Starting": "等待启动广告：必须识别左上角返回按钮并关闭后，才允许确认主界面"
        }
    },
    "GameLoginWaitTapScreen": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/AdvertisementReturn720.png"
                ],
                "threshold": 0.99,
                "roi": [
                    0,
                    45,
                    125,
                    65
                ]
            }
        },
        "inverse": true,
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    360,
                    1135
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 1000
    },
    "GameLoginReconnect": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/Reconnect720.png"
                ],
                "threshold": 0.96,
                "roi": [
                    235,
                    675,
                    250,
                    100
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "post_delay": 1000,
        "max_hit": 5,
        "focus": {
            "Node.Action.Succeeded": "检测到网络异常重新连线按钮，已点击并继续识别启动状态"
        }
    },
    "GameLoginReconnectExhausted": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/Reconnect720.png"
                ],
                "threshold": 0.96,
                "roi": [
                    235,
                    675,
                    250,
                    100
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "GameLoginStopAfterTimeout"
        ],
        "focus": {
            "Node.Action.Starting": "重新连线已达五次，网络仍未恢复，结束本次登录并交由统一异常恢复处理"
        }
    },
    "GameLoginRestartOnce": {
        "next": [
            "GameLoginStopAfterTimeout"
        ]
    },
    "GameLoginStopAfterTimeout": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "__GameLoginCannotComplete"
        ],
        "timeout": 1000,
        "focus": {
            "Node.Action.Starting": "启动失败：尚未完成“点击广告返回按钮 → 按钮消失 → 识别出征”，交由故障策略处理。"
        }
    },
    "GameTapTitleScreen": {
