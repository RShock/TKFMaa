    "GameCloseGift": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/AdvertisementReturn720.png"
                ],
                "threshold": 0.99,
                "roi": [
                    0,
                    45,
                    125,
                    65
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
