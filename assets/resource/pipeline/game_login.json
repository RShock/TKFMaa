        "max_hit": 3,
        "post_delay": 800,
        "pre_wait_freezes": {
            "time": 300,
            "timeout": 1500
        },
        "next": [
            "GameLoginWaitAdvertisementClosed"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "已识别启动弹窗广告左上角返回按钮，准备点击图片中心。",
            "Node.Action.Succeeded": "已点击广告返回按钮；按钮消失后识别出征，才算启动完成。"
        }
