{
    "GameLoginStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmRunWithRecovery",
                "custom_action_param": {
                    "entry": "GameLoginStartAttempt",
                    "label": "启动游戏"
                }
            }
        }
    },
    "GameLoginStartAttempt": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.pinkcore.tkfm"
            }
        },
        "next": [
            "GameLoginLaunch"
        ]
    },
    "GameLoginLaunch": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.pinkcore.tkfm"
            }
        },
        "next": [
            "GameLoginDispatch"
        ]
    },
    "GameLoginDispatch": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 360000,
        "next": [
            "[JumpBack]GameLoginReconnect",
            "GameLoginReconnectExhausted",
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]GameWaitResourceCheck",
            "GameCloseGift",
            "[JumpBack]GameCloseAnnouncement",
            "[JumpBack]GameCloseSignIn",
            "[JumpBack]GameTapTitleScreen",
            "[JumpBack]GameLoginWaitTapScreen"
        ],
        "on_error": [
            "GameLoginStopAfterTimeout"
        ],
        "focus": {
            "Node.Action.Starting": "等待启动广告：必须识别左上角返回按钮并关闭后，才允许确认主界面"
        }
    },
    "GameLoginWaitTapScreen": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/AdvertisementReturn720.png"
                ],
                "threshold": 0.99,
                "roi": [
                    0,
                    45,
                    125,
                    65
                ]
            }
        },
        "inverse": true,
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    360,
                    1135
                ]
            }
        },
        "pre_delay": 0,
        "post_delay": 1000
    },
    "GameLoginReconnect": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/Reconnect720.png"
                ],
                "threshold": 0.96,
                "roi": [
                    235,
                    675,
                    250,
                    100
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "post_delay": 1000,
        "max_hit": 5,
        "focus": {
            "Node.Action.Succeeded": "检测到网络异常重新连线按钮，已点击并继续识别启动状态"
        }
    },
    "GameLoginReconnectExhausted": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/Reconnect720.png"
                ],
                "threshold": 0.96,
                "roi": [
                    235,
                    675,
                    250,
                    100
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "GameLoginStopAfterTimeout"
        ],
        "focus": {
            "Node.Action.Starting": "重新连线已达五次，网络仍未恢复，结束本次登录并交由统一异常恢复处理"
        }
    },
    "GameLoginRestartOnce": {
        "next": [
            "GameLoginStopAfterTimeout"
        ]
    },
    "GameLoginStopAfterTimeout": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "__GameLoginCannotComplete"
        ],
        "timeout": 1000,
        "focus": {
            "Node.Action.Starting": "登录失败：未完成启动广告关闭及主界面确认，禁止按成功结束"
        }
    },
    "GameTapTitleScreen": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "TAPTO START",
                    "TAP TO START",
                    "TAPTOSTART",
                    "TAPTOSTAR",
                    "Ver",
                    "Ver.",
                    "Ver.2.2.1"
                ],
                "threshold": 0.3,
                "roi": [
                    180,
                    1060,
                    540,
                    220
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    360,
                    1135
                ]
            }
        },
        "max_hit": 5,
        "post_delay": 1500
    },
    "GameWaitResourceCheck": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "资源检查中",
                    "档案读取中"
                ],
                "roi": [
                    180,
                    1120,
                    360,
                    130
                ]
            }
        }
    },
    "GameCloseEventSignIn": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__GameSignInTouchScreen"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "max_hit": 2,
        "post_delay": 800,
        "pre_wait_freezes": 300
    },
    "GameCloseAnnouncement": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    150,
                    520,
                    120
                ],
                "threshold": 0.3,
                "expected": [
                    "王城公布栏",
                    "活动公告",
                    "最新公告"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    360,
                    1155
                ]
            }
        },
        "max_hit": 3,
        "post_delay": 800,
        "pre_wait_freezes": 300
    },
    "GameCloseSignIn": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__GameSignInTouchScreen"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "max_hit": 4,
        "post_delay": 800,
        "pre_wait_freezes": 300
    },
    "GameCloseGift": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/AdvertisementReturn720.png"
                ],
                "threshold": 0.99,
                "roi": [
                    0,
                    45,
                    125,
                    65
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "max_hit": 3,
        "post_delay": 800,
        "pre_wait_freezes": 300,
        "next": [
            "GameLoginWaitAdvertisementClosed"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "已识别启动广告返回按钮（图片阈值 0.99），准备关闭",
            "Node.Action.Succeeded": "已点击广告返回按钮，下一步确认广告消失及主界面"
        }
    },
    "GameMainReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ]
            }
        },
        "action": {
            "type": "StopTask"
        },
        "focus": {
            "Node.Action.Starting": "启动广告已关闭，返回按钮已消失，主界面二次确认通过"
        }
    },
    "__GameSignInTouchScreen": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    140,
                    1080,
                    440,
                    170
                ],
                "expected": [
                    "TOUCH\\s*SCREEN"
                ],
                "threshold": 0.5
            }
        }
    },
    "GameLoginConfirmMain": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "post_delay": 1500,
        "next": [
            "GameLoginMainInterrupted",
            "GameMainReady",
            "GameLoginAfterAdvertisement"
        ],
        "max_hit": 5
    },
    "GameLoginMainInterrupted": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "GameLoginReconnect",
                    "CommonWaitLoading",
                    "GameWaitResourceCheck",
                    "GameCloseGift",
                    "GameCloseAnnouncement",
                    "GameCloseSignIn",
                    "GameTapTitleScreen"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "GameLoginAfterAdvertisement"
        ],
        "max_hit": 5
    },
    "GameLoginAfterAdvertisement": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 360000,
        "next": [
            "[JumpBack]GameLoginReconnect",
            "GameLoginReconnectExhausted",
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]GameWaitResourceCheck",
            "GameCloseGift",
            "[JumpBack]GameCloseAnnouncement",
            "[JumpBack]GameCloseSignIn",
            "[JumpBack]GameTapTitleScreen",
            "GameLoginConfirmMain"
        ],
        "on_error": [
            "GameLoginStopAfterTimeout"
        ]
    },
    "GameLoginWaitAdvertisementClosed": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 30000,
        "next": [
            "[JumpBack]GameLoginReconnect",
            "GameLoginReconnectExhausted",
            "GameCloseGift",
            "GameLoginAdvertisementGone"
        ],
        "on_error": [
            "GameLoginStopAfterTimeout"
        ]
    },
    "GameLoginAdvertisementGone": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/AdvertisementReturn720.png"
                ],
                "threshold": 0.99,
                "roi": [
                    0,
                    45,
                    125,
                    65
                ]
            }
        },
        "inverse": true,
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "GameLoginAfterAdvertisement"
        ],
        "focus": {
            "Node.Action.Succeeded": "已重新截图确认广告返回按钮消失，开始确认主界面"
        }
    },
    "__GameLoginCannotComplete": {
        "recognition": {
            "type": "DirectHit"
        },
        "inverse": true
    },
    "GameLoginNeedsCompletion": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "GameLoginReconnect",
                    "GameTapTitleScreen",
                    "GameWaitResourceCheck",
                    "GameCloseGift",
                    "GameCloseAnnouncement",
                    "GameCloseSignIn"
                ]
            }
        }
    }
}
