    "GameMainReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__CommonMainExpeditionButton"
                ]
            }
        },
        "action": {
            "type": "StopTask"
        },
        "focus": {
            "Node.Action.Starting": "启动完成：已点击广告左上角返回按钮，确认按钮消失，并识别到出征。"
        }
    },
    "__GameSignInTouchScreen": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    140,
                    1080,
                    440,
                    170
                ],
                "expected": [
                    "TOUCH\\s*SCREEN"
                ],
                "threshold": 0.5
            }
        }
    },
    "GameLoginConfirmMain": {
        "next": [
            "GameLoginAfterAdvertisement"
        ]
    },
    "GameLoginMainInterrupted": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "GameLoginReconnect",
                    "GameSkipStartupAnimation",
                    "CommonWaitLoading",
                    "GameWaitResourceCheck",
                    "GameCloseGift",
                    "GameCloseAnnouncement",
                    "GameCloseSignIn",
                    "GameTapTitleScreen"
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "GameLoginAfterAdvertisement"
        ],
        "max_hit": 5
    },
    "GameLoginAfterAdvertisement": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 360000,
        "next": [
            "[JumpBack]GameLoginReconnect",
            "GameLoginReconnectExhausted",
            "[JumpBack]GameSkipStartupAnimation",
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]GameWaitResourceCheck",
            "GameCloseGift",
            "[JumpBack]GameCloseAnnouncement",
            "[JumpBack]GameCloseSignIn",
            "[JumpBack]GameTapTitleScreen",
            "GameMainReady"
        ],
        "on_error": [
            "GameLoginStopAfterTimeout"
        ]
    },
    "GameLoginWaitAdvertisementClosed": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 30000,
        "next": [
            "[JumpBack]GameLoginReconnect",
            "GameLoginReconnectExhausted",
            "[JumpBack]GameSkipStartupAnimation",
            "GameCloseGift",
            "GameLoginAdvertisementGone"
        ],
        "on_error": [
            "GameLoginStopAfterTimeout"
        ]
    },
    "GameLoginAdvertisementGone": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/AdvertisementReturn720.png"
                ],
                "threshold": 0.99,
                "roi": [
                    0,
                    45,
                    125,
                    65
                ]
            }
        },
        "inverse": true,
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "GameLoginAfterAdvertisement"
        ],
        "focus": {
            "Node.Action.Succeeded": "已重新截图确认广告返回按钮消失，开始确认主界面"
        }
    },
    "__GameLoginCannotComplete": {
        "recognition": {
            "type": "DirectHit"
        },
        "inverse": true
    },
    "GameLoginNeedsCompletion": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "GameLoginReconnect",
                    "GameTapTitleScreen",
                    "GameWaitResourceCheck",
                    "GameCloseGift",
                    "GameCloseAnnouncement",
                    "GameCloseSignIn",
                    "GameSkipStartupAnimation",
                    "CommonWaitLoading"
                ]
            }
        }
    },
    "GameSkipStartupAnimation": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/StartupSkip720.png"
                ],
                "threshold": 0.94,
                "roi": [
                    590,
                    40,
                    115,
                    80
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "timeout": 1500
        },
        "post_delay": 1000,
        "max_hit": 5,
        "focus": {
            "Node.Action.Succeeded": "启动游戏：识别到启动动画的 SKIP，已点击按钮中心，继续识别画面。"
        }
