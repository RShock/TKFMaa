    "__GameLoginGamePageVisible": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "CommonMainReady",
                    "DailyShopAlreadyInShop",
                    "__DailyFriendStaminaProfilePage",
                    "__DailyAlchemyOrdersPageReady",
                    "__DailyRecruitmentOverviewTitle",
                    "__DailyRecruitmentSetupReady",
                    "__GameLoginDispatchOverview",
                    "__GameLoginTrainingDetail",
                    "__GameLoginTaskPage",
                    "CommonReturnMainFromStaminaStageList",
                    "CommonReturnMainFromSummon"
                ]
            }
        }
    },
    "GameLoginWaitForAdvertisement": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__GameLoginGamePageVisible"
                ]
            }
        },
        "post_delay": 1000,
        "max_hit": 60,
        "focus": {
            "Node.Recognition.Succeeded": "已看到游戏内按钮，但尚未关闭本轮启动广告，继续等待广告出现。"
        }
    },
    "GameLoginAdvertisementMissing": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__GameLoginGamePageVisible"
                ]
            }
        },
        "next": [
            "GameLoginStopAfterTimeout"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "等待启动广告的次数已用尽，未完成广告返回点击，禁止按启动成功放行。"
        }
    }
