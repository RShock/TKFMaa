    "GameLoginEnsureReady": {
        "next": [
            "GameLoginDispatch"
        ],
        "focus": {
            "Node.Action.Starting": "自动启动：必须识别并点击启动广告左上角返回按钮，再识别出征；提前出现主页或召唤时只等待广告。"
        }
    },
