{
    "GameLoginStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmRunWithRecovery",
                "custom_action_param": {
                    "entry": "GameLoginStartAttempt",
                    "label": "启动游戏"
                }
            }
        }
    },
    "GameLoginStartAttempt": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.pinkcore.tkfm"
            }
        },
        "next": [
            "GameLoginLaunch"
        ]
    },
    "GameLoginLaunch": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.pinkcore.tkfm"
            }
        },
        "next": [
            "GameLoginDispatch"
        ]
    },
    "GameLoginDispatch": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 360000,
        "next": [
            "[JumpBack]TkfmRecoverySessionExpiredPriority",
            "[JumpBack]GameLoginReconnect",
            "GameLoginReconnectExhausted",
            "[JumpBack]GameSkipStartupAnimation",
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]GameWaitResourceCheck",
            "GameCloseGift",
            "[JumpBack]GameCloseAnnouncement",
            "[JumpBack]GameCloseEventSignIn",
            "[JumpBack]GameCloseSignIn",
            "[JumpBack]GameTapTitleScreen",
            "GameMainReady",
            "[JumpBack]GameLoginWaitTapScreen"
        ],
        "on_error": [
            "GameLoginStopAfterTimeout"
        ],
        "focus": {
            "Node.Action.Starting": "按当前画面继续登录；识别到无遮挡的出征即完成，不等待广告出现。"
        }
    },
    "GameLoginWaitTapScreen": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": ["__GameSignInTouchScreen"],
                    "absent": ["TkfmRecoveryMonthlyCardTitle"]
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_delay": 0,
        "post_delay": 1000,
        "max_hit": 4,
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        }
    },
    "GameLoginReconnect": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/Reconnect720.png"
                ],
                "threshold": 0.96,
                "roi": [
                    235,
                    675,
                    250,
                    100
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "post_delay": 1000,
        "max_hit": 5,
        "focus": {
            "Node.Action.Succeeded": "检测到网络异常重新连线按钮，已点击并继续识别启动状态"
        }
    },
    "GameLoginReconnectExhausted": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "GameLogin/Reconnect720.png"
                ],
                "threshold": 0.96,
                "roi": [
                    235,
                    675,
                    250,
                    100
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "GameLoginStopAfterTimeout"
        ],
        "focus": {
            "Node.Action.Starting": "重新连线已达五次，网络仍未恢复，结束本次登录并交由统一异常恢复处理"
        }
    },
    "GameLoginRestartOnce": {
        "next": [
            "GameLoginStopAfterTimeout"
        ]
    },
    "GameLoginStopAfterTimeout": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "__GameLoginCannotComplete"
        ],
        "timeout": 1000,
        "focus": {
            "Node.Action.Starting": "登录页面识别超时，尚未识别到无遮挡的出征，交由故障策略处理。"
        }
    },
