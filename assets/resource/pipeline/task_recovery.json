{
    "TkfmRecoveryConfig": {
        "attach": {
            "login_packages": [
                "com.pinkcore.tkfm",
                "com.pinkcore.tkfm.erolabs"
            ],
            "preserve_hits": [
                "DailyStaminaUsePotionPopup",
                "DailyStaminaBuyStaminaPopup",
                "RegularActivityUsePotionPopup",
                "RegularActivityBuyStaminaPopup",
                "DailyTrainingClickCenterSlow",
                "DailyTrainingClickCenterAllPoints",
                "DailyRecruitmentCycleCompleted",
                "DailyAlchemyOrdersCollect",
                "DailyAlchemyOrdersDeliverVisibleOrder",
                "DailyAlchemyOrdersStartBlueProduction",
                "TkfmRecoverySessionExpired",
                "TkfmRecoveryAdvertisement",
                "TkfmRecoveryAnnouncement",
                "TkfmRecoveryEventSignIn",
                "TkfmRecoverySignIn",
                "GameCloseSignIn",
                "TkfmRecoveryBackButton",
                "TkfmRecoverySystemBack",
                "GameLoginBackFallback",
                "GameLoginExistingGiftFallback"
            ]
        }
    },
    "TkfmRecoverySessionExpiredTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "GameLogin/SessionExpiredTitle720.png",
                "roi": [
                    290,
                    505,
                    140,
                    90
                ],
                "threshold": 0.9
            }
        }
    },
    "TkfmRecoverySessionExpiredButton": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "GameLogin/SessionExpiredConfirm720.png",
                "roi": [
                    235,
                    655,
                    250,
                    110
                ],
                "threshold": 0.94
            }
        }
    },
    "TkfmRecoverySessionExpiredTarget": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TkfmRecoverySessionExpiredTitle",
                    "TkfmRecoverySessionExpiredButton"
                ],
                "box_index": 1
            }
        }
    },
    "TkfmRecoverySessionExpiredPriority": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TkfmRecoverySessionExpiredTarget"
                ]
            }
        },
        "next": [
            "TkfmRecoverySessionExpired"
        ],
        "on_error": [
            "TkfmTaskFailure"
        ],
        "timeout": 1000
    },
    "TkfmRecoverySessionExpired": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TkfmRecoveryPopup",
                "custom_recognition_param": {
                    "target": "TkfmRecoverySessionExpiredTarget"
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "post_delay": 800,
        "timeout": 1000,
        "max_hit": 2,
        "next": [
            "GameLoginEnsureReady"
        ],
        "on_error": [
            "TkfmTaskFailure"
        ],
        "focus": {
            "Node.Action.Starting": "异常恢复：检测到中部提示框和确定按钮，按服务器异常／跨日失效处理，点击按钮中心后重新进入登录流程（共享最多两次）。",
            "Node.Action.Succeeded": "已点击异常提示的确定按钮，继续识别登录页面；识别到无遮挡的出征后再继续原任务，保留购买与消耗记录。"
        }
    },
    "TkfmRecoveryRestartGame": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.pinkcore.tkfm"
            }
        },
        "next": [
            "GameLoginLaunch"
        ],
        "focus": {
            "Node.Action.Starting": "异常恢复：结束游戏进程并重新登录；当前步骤仅允许一次重启"
        }
    },
    "TkfmTaskFailure": {
        "recognition": {
            "type": "DirectHit"
        },
        "inverse": true,
        "timeout": 1000
    },
    "TkfmRecoveryAdvertisement": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TkfmRecoveryPopup",
                "custom_recognition_param": {
                    "target": "GameCloseGift"
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "timeout": 1500
        },
        "post_delay": 800,
        "timeout": 10000,
        "next": [
            "TkfmRecoveryAdvertisementClosed",
            "TkfmRecoveryAdvertisement"
        ],
        "focus": {
            "Node.Action.Starting": "异常恢复：检测到返回箭头，点击图片中心后继续识别（与公告、签到和普通返回合计最多两次）。"
        }
    },
    "TkfmRecoveryAnnouncement": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TkfmRecoveryPopup",
                "custom_recognition_param": {
                    "target": "GameCloseAnnouncement"
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    360,
                    1155
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                275,
                1125,
                170,
                65
            ],
            "timeout": 1500
        },
        "post_delay": 800,
        "timeout": 10000,
        "next": [
            "TkfmRecoveryAnnouncementClosed",
            "TkfmRecoveryAnnouncement"
        ],
        "focus": {
            "Node.Action.Starting": "异常恢复：检测到王城公布栏等公告标题，点击屏幕下方空白处关闭，再继续识别登录页面（共享最多两次恢复）。"
        }
    },
    "TkfmRecoveryEventSignIn": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TkfmRecoveryPopup",
                "custom_recognition_param": {
                    "target": "GameCloseEventSignIn"
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "post_delay": 800,
        "timeout": 10000,
        "next": [
            "GameLoginEnsureReady"
        ],
        "focus": {
            "Node.Action.Starting": "异常恢复：检测到活动签到页的“结束时间”，点击文字中心；随后继续处理月度签到等登录页面，确认出征后再返回原步骤（共享最多两次恢复）。"
        }
    },
    "TkfmRecoveryBackButtonTarget": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "Common/TopLeftBackFull720.png",
                "roi": [
                    0,
                    45,
                    125,
                    65
                ],
                "threshold": 0.9
            }
        }
    },
    "TkfmRecoveryMonthlyCardTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "GameLogin/MonthlyCardTitle720.png",
                "roi": [0, 750, 190, 80],
                "threshold": 0.9
            }
        }
    },
    "TkfmRecoveryMonthlyCardTarget": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "TkfmRecoveryMonthlyCardTitle",
                    "__GameSignInTouchScreen"
                ],
                "box_index": 1
            }
        }
    },
    "TkfmRecoverySignIn": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TkfmRecoveryPopup",
                "custom_recognition_param": {
                    "target": "TkfmRecoveryMonthlyCardTarget"
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "post_delay": 800,
        "max_hit": 1,
        "next": [
            "GameLoginDispatch"
        ],
        "focus": {
            "Node.Action.Starting": "异常恢复：检测到“魔王月卡”和底部 TOUCH SCREEN，点击 TOUCH SCREEN 中心恰好一次，随后复用登录流程关闭公告和广告，看到无遮挡的出征后再继续原任务。"
        }
    },
    "TkfmRecoveryBackButton": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TkfmRecoveryPopup",
                "custom_recognition_param": {
                    "target": "TkfmRecoveryBackButtonTarget"
                }
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "post_delay": 800,
        "max_hit": 2,
        "focus": {
            "Node.Action.Starting": "异常恢复：识别到左上角返回按钮，点击按钮中心，再回到原步骤按当前画面继续；不把返回视为任务完成（共享最多两次）。"
        }
    },
    "TkfmRecoveryVisibleGame": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__CommonMainExpeditionButton",
                    "DailyShopAlreadyInShop"
                ]
            }
        }
    },
    "TkfmRecoveryAdvertisementClosed": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "TkfmRecoveryVisibleGame"
                    ],
                    "absent": [
                        "TkfmRecoverySessionExpiredTarget",
                        "GameCloseGift",
                        "GameCloseAnnouncement",
                        "GameCloseEventSignIn",
                        "TkfmRecoveryMonthlyCardTarget"
                    ]
                }
            }
        },
        "focus": {
            "Node.Action.Succeeded": "异常恢复：广告已关闭且游戏页面已识别，回到中断处继续识别；保留购买记录和资源额度。"
        }
    },
    "TkfmRecoveryAnnouncementClosed": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    150,
                    520,
                    120
                ],
                "threshold": 0.3,
                "expected": [
                    "王城公布栏",
                    "活动公告",
                    "最新公告",
                    "王城公佈欄",
                    "活動公告",
                    "最新佈告"
                ]
            }
        },
        "inverse": true,
        "next": [
            "GameLoginEnsureReady"
        ],
        "focus": {
            "Node.Action.Succeeded": "异常恢复：公告已关闭，继续识别当前登录页面；看到出征即完成，不等待广告。"
        }
    },
    "__TkfmRecoveryAnyScreen": {
        "recognition": {
            "type": "DirectHit"
        }
    },
    "TkfmRecoverySystemBack": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": ["__TkfmRecoveryAnyScreen"],
                    "absent": ["CommonMainReady"]
                }
            }
        },
        "action": {
            "type": "ClickKey",
            "param": {
                "key": [4]
            }
        },
        "post_delay": 1000,
        "max_hit": 3,
        "focus": {
            "Node.Action.Starting": "异常恢复：已知恢复均未命中，发送一次安卓返回键，随后重新识别当前步骤；每任务最多三次，已回主页时不发送。"
        }
    },
    "TkfmRecoveryUnhandled": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "TkfmTaskFailure"
        ],
        "timeout": 1
    }
}
