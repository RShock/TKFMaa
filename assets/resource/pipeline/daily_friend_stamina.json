{
    "DailyFriendStaminaStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmRunWithRecovery",
                "custom_action_param": {
                    "entry": "DailyFriendStaminaStartAttempt",
                    "label": "领取体力",
                    "success_any_hit": [
                        "DailyFriendStaminaDone"
                    ]
                }
            }
        }
    },
    "DailyFriendStaminaStartAttempt": {
        "next": [
            "DailyFriendStaminaWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "DailyFriendStaminaCloseReward",
            "DailyFriendStaminaAlreadyClaimed",
            "DailyFriendStaminaClickReceive",
            "DailyFriendStaminaOpenFriendList",
            "DailyFriendStaminaOpenProfileFromMain"
        ],
        "timeout": 15000,
        "max_hit": 30
    },
    "DailyFriendStaminaOpenProfileFromMain": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ],
                "box_index": 0
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    150,
                    105
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "timeout": 1500,
            "target": [
                85,
                65,
                135,
                80
            ]
        },
        "post_delay": 500,
        "next": [
            "DailyFriendStaminaStartAttempt"
        ],
        "max_hit": 5
    },
    "DailyFriendStaminaOpenFriendList": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyFriendStaminaPersonalSelected",
                    "__DailyFriendStaminaFriendListButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "timeout": 1500
        },
        "post_delay": 500,
        "next": [
            "DailyFriendStaminaStartAttempt"
        ],
        "max_hit": 5
    },
    "DailyFriendStaminaClickReceive": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyFriendStaminaFriendListSelected",
                    "__DailyFriendStaminaClaimButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "timeout": 1500
        },
        "post_delay": 1000,
        "next": [
            "DailyFriendStaminaStartAttempt"
        ],
        "max_hit": 3,
        "focus": {
            "Node.Action.Succeeded": "领取体力：识别到可领取按钮，已点击中心；继续按当前画面选择动作。"
        }
    },
    "DailyFriendStaminaAlreadyClaimed": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyFriendStaminaFriendListSelected",
                    "__DailyFriendStaminaClaimedButton",
                    "__DailyFriendStaminaProfileCloseButton"
                ],
                "box_index": 2
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "timeout": 1500
        },
        "post_delay": 500,
        "next": [
            "DailyFriendStaminaReceive"
        ],
        "max_hit": 5,
        "focus": {
            "Node.Action.Succeeded": "领取体力：当前显示已领取，已点击关闭玩家信息。"
        }
    },
    "DailyFriendStaminaReceive": {
        "next": [
            "DailyFriendStaminaFinishWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "DailyFriendStaminaFinishCloseReward",
            "DailyFriendStaminaCloseProfile",
            "DailyFriendStaminaDone"
        ],
        "timeout": 10000,
        "max_hit": 15
    },
    "DailyFriendStaminaCloseProfile": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyFriendStaminaProfilePage",
                    "__DailyFriendStaminaProfileCloseButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "timeout": 1500
        },
        "post_delay": 500,
        "next": [
            "DailyFriendStaminaReceive"
        ],
        "max_hit": 5,
        "focus": {
            "Node.Action.Succeeded": "领取体力：玩家信息的关闭按钮仍在，已重新识图点击中心。"
        }
    },
    "DailyFriendStaminaDone": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ],
                "box_index": 0
            }
        },
        "focus": {
            "Node.Recognition.Succeeded": "领取体力：已领取并回到主页，任务结束。"
        }
    },
