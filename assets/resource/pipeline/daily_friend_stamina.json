{
    "DailyFriendStaminaStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmRunWithRecovery",
                "custom_action_param": {
                    "entry": "DailyFriendStaminaStartAttempt",
                    "label": "领取体力",
                    "success_any_hit": [
                        "DailyFriendStaminaClickReceive",
                        "DailyFriendStaminaAlreadyClaimed"
                    ]
                }
            }
        }
    },
    "DailyFriendStaminaStartAttempt": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "DailyFriendStaminaOpenProfileFromMain",
            "DailyFriendStaminaOpenFriendList",
            "DailyFriendStaminaReceive"
        ],
        "timeout": 10000,
        "on_error": [
            "DailyFriendStaminaAbortToMain"
        ]
    },
    "DailyFriendStaminaOpenProfileFromMain": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    150,
                    105
                ]
            }
        },
        "post_wait_freezes": {
            "time": 700,
            "target": [
                0,
                0,
                0,
                0
            ]
        },
        "next": [
            "DailyFriendStaminaOpenFriendList"
        ],
        "pre_wait_freezes": 300,
        "on_error": [
            "DailyFriendStaminaAbortToMain"
        ]
    },
    "DailyFriendStaminaOpenFriendList": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    60,
                    180,
                    220,
                    100
                ],
                "template": [
                    "DailyFriendStamina/ProfilePersonalSelected720.png"
                ],
                "threshold": 0.92
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    360,
                    219
                ]
            }
        },
        "post_wait_freezes": {
            "time": 700,
            "target": [
                0,
                0,
                0,
                0
            ]
        },
        "next": [
            "DailyFriendStaminaReceive"
        ],
        "pre_wait_freezes": 300,
        "on_error": [
            "DailyFriendStaminaAbortToMain"
        ]
    },
    "DailyFriendStaminaReceive": {
        "next": [
            "DailyFriendStaminaClickReceive",
            "DailyFriendStaminaAlreadyClaimed"
        ],
        "timeout": 15000,
        "on_error": [
            "DailyFriendStaminaAbortToMain"
        ],
        "post_delay": 500
    },
    "DailyFriendStaminaClickReceive": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    360,
                    1050,
                    280,
                    120
                ],
                "template": [
                    "DailyFriendStamina/OneClickClaim720.png"
                ],
                "threshold": 0.92
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_wait_freezes": {
            "time": 700,
            "target": [
                0,
                0,
                0,
                0
            ]
        },
        "next": [
            "DailyFriendStaminaCloseProfile"
        ],
        "max_hit": 1,
        "pre_wait_freezes": 300,
        "on_error": [
            "DailyFriendStaminaAbortToMain"
        ]
    },
    "DailyFriendStaminaCloseProfile": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    240,
                    175,
                    240,
                    100
                ],
                "template": [
                    "DailyFriendStamina/FriendListSelected720.png"
                ],
                "threshold": 0.92
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    360,
                    1220
                ]
            }
        },
        "next": [
            "DailyFriendStaminaDone"
        ],
        "pre_wait_freezes": 300,
        "on_error": [
            "DailyFriendStaminaAbortToMain"
        ]
    },
    "DailyFriendStaminaCloseProfileForRetry": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    240,
                    175,
                    240,
                    100
                ],
                "template": [
                    "DailyFriendStamina/FriendListSelected720.png"
                ],
                "threshold": 0.92
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    360,
                    1220
                ]
            }
        },
        "next": [
            "DailyFriendStaminaOpenProfileFromMain"
        ],
        "max_hit": 1,
        "pre_wait_freezes": 300,
        "on_error": [
            "DailyFriendStaminaAbortToMain"
        ]
    },
    "DailyFriendStaminaDone": {
        "next": [
            "CommonStopOnMainWithRetries"
        ]
    },
    "DailyFriendStaminaAbortToMain": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "[JumpBack]CommonCloseReward",
            "CommonEnsureMain"
        ]
    },
    "DailyFriendStaminaAlreadyClaimed": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    360,
                    1050,
                    280,
                    120
                ],
                "template": [
                    "DailyFriendStamina/OneClickClaimed720.png"
                ],
                "threshold": 0.92
            }
        },
        "next": [
            "DailyFriendStaminaCloseProfile"
        ],
        "max_hit": 1
    }
