{
    "DailyAlchemyOrdersStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmRunWithRecovery",
                "custom_action_param": {
                    "entry": "DailyAlchemyOrdersStartAttempt",
                    "label": "炼金订单"
                }
            }
        }
    },
    "DailyAlchemyOrdersStartAttempt": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "DailyAlchemyOrdersOpenDrawer",
            "[JumpBack]CommonCloseReward",
            "[JumpBack]CommonEnsureMain"
        ],
        "timeout": 10000
    },
    "DailyAlchemyOrdersOpenDrawer": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    35,
                    630
                ]
            }
        },
        "next": [
            "DailyAlchemyOrdersOpenAlchemy"
        ],
        "pre_wait_freezes": 300
    },
    "DailyAlchemyOrdersOpenAlchemy": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "派遣队1"
                ],
                "roi": [
                    0,
                    520,
                    120,
                    70
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    116,
                    510
                ]
            }
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "DailyAlchemyOrdersCollect"
        ],
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        }
    },
    "DailyAlchemyOrdersCollect": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyAlchemyOrdersPageReady",
                    "__DailyAlchemyOrdersCollectButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {},
                "target": true
            }
        },
        "next": [
            "[JumpBack]CommonCloseReward",
            "DailyAlchemyOrdersScanOrder"
        ],
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        }
    },
    "DailyAlchemyOrdersScanOrder": {
        "next": [
            "[JumpBack]CommonCloseReward",
            "[JumpBack]CommonWaitLoading",
            "DailyAlchemyOrdersDeliverVisibleOrder",
            "DailyAlchemyOrdersVerifyComplete"
        ],
        "timeout": 5000,
        "on_error": [
            "DailyAlchemyOrdersAbortToMain"
        ]
    },
    "DailyAlchemyOrdersDeliverVisibleOrder": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyAlchemyOrdersPageReady",
                    "__DailyAlchemyOrdersDeliverable"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {},
                "target": true,
                "target_offset": [
                    67,
                    76,
                    0,
                    0
                ]
            }
        },
        "next": [
            "DailyAlchemyOrdersAwaitDeliveryResult"
        ],
        "max_hit": 10,
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "on_error": [
            "DailyAlchemyOrdersAbortToMain"
        ]
    },
    "DailyAlchemyOrdersAbortToMain": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseReward",
            "CommonEnsureMain"
        ],
        "timeout": 15000
    },
    "DailyAlchemyOrdersReturnMain": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "__DailyAlchemyOrdersTitle",
                        "__DailyAlchemyOrdersCount",
                        "__DailyAlchemyOrdersCollectButton"
                    ],
                    "absent": [
                        "__DailyAlchemyOrdersDeliverable",
                        "__DailyAlchemyOrdersRewardPopup"
                    ]
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    40,
                    72
                ]
            }
        },
        "next": [
            "DailyAlchemyOrdersDone"
        ],
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                15,
                52,
                85,
                44
            ],
            "timeout": 1500
        },
        "max_hit": 3
    },
    "DailyAlchemyOrdersDone": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMainObserve"
        ],
        "timeout": 1500,
        "on_error": [
            "DailyAlchemyOrdersReturnMain"
        ]
    },
    "__DailyAlchemyOrdersTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "DailyAlchemyOrders/Title720.png",
                "roi": [
                    90,
                    130,
                    100,
                    55
                ],
                "threshold": 0.9
            }
        }
    },
    "__DailyAlchemyOrdersCount": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "^订单\\s*([0-7]\\s*/\\s*7|[0-9]\\s*/\\s*9)\\s*$"
                ],
                "roi": [
                    0,
                    840,
                    160,
                    65
                ]
            }
        }
    },
    "__DailyAlchemyOrdersCollectButton": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "DailyAlchemyOrders/CollectButton720.png",
                "roi": [
                    380,
                    765,
                    225,
                    75
                ],
                "threshold": 0.9
            }
        }
    },
    "__DailyAlchemyOrdersDeliverable": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "DailyAlchemyOrders/DeliverableMarker720.png",
                "roi": [
                    25,
                    938,
                    525,
                    52
                ],
                "threshold": 0.9,
                "order_by": "Horizontal",
                "index": 0
            }
        }
    },
    "__DailyAlchemyOrdersRewardPopup": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "获得奖励|奖励已增加至仓库"
                ],
                "roi": [
                    200,
                    400,
                    330,
                    410
                ]
            }
        }
    },
    "DailyAlchemyOrdersVerifyComplete": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "__DailyAlchemyOrdersTitle",
                        "__DailyAlchemyOrdersCount",
                        "__DailyAlchemyOrdersCollectButton"
                    ],
                    "absent": [
                        "__DailyAlchemyOrdersDeliverable",
                        "__DailyAlchemyOrdersRewardPopup"
                    ]
                }
            }
        },
        "post_delay": 500,
        "next": [
            "[JumpBack]CommonCloseReward",
            "[JumpBack]CommonWaitLoading",
            "DailyAlchemyOrdersDeliverVisibleOrder",
            "DailyAlchemyOrdersReturnMain"
        ],
        "timeout": 5000,
        "max_hit": 3,
        "on_error": [
            "DailyAlchemyOrdersAbortToMain"
        ]
    },
    "DailyAlchemyOrdersAwaitDeliveryResult": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "DailyAlchemyOrdersCloseDeliveryReward"
        ],
        "timeout": 3500,
        "on_error": [
            "DailyAlchemyOrdersDeliveryRetry",
            "DailyAlchemyOrdersAbortToMain"
        ]
    },
    "DailyAlchemyOrdersDeliverySucceeded": {
        "recognition": {
            "type": "DirectHit"
        },
        "post_delay": 400,
        "next": [
            "DailyAlchemyOrdersScanOrder"
        ]
    },
    "DailyAlchemyOrdersDeliveryRetry": {
        "recognition": {
            "type": "DirectHit"
        },
        "max_hit": 1,
        "next": [
            "DailyAlchemyOrdersDeliverVisibleOrder"
        ],
        "on_error": [
            "DailyAlchemyOrdersAbortToMain"
        ]
    },
    "DailyAlchemyOrdersCloseDeliveryReward": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "确定",
                    "确认"
                ],
                "roi": [
                    300,
                    700,
                    120,
                    80
                ]
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {},
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                300,
                700,
                120,
                80
            ],
            "timeout": 1500
        },
        "post_delay": 500,
        "next": [
            "DailyAlchemyOrdersDeliverySucceeded"
        ]
    },
    "__DailyAlchemyOrdersPageReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyAlchemyOrdersTitle",
                    "__DailyAlchemyOrdersCount",
                    "__DailyAlchemyOrdersCollectButton"
                ]
            }
        }
    }
}
