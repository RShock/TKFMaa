{
    "DailyAlchemyOrdersStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmRunWithRecovery",
                "custom_action_param": {
                    "entry": "DailyAlchemyOrdersStartAttempt",
                    "label": "炼金订单",
                    "success_any_hit": [
                        "DailyAlchemyOrdersDone"
                    ]
                }
            }
        }
    },
    "DailyAlchemyOrdersStartAttempt": {
        "next": [
            "DailyAlchemyOrdersScanOrder"
        ],
        "timeout": 10000
    },
    "DailyAlchemyOrdersOpenDrawer": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady",
                    "__DailyAlchemyOrdersDrawerArrow"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "next": [
            "DailyAlchemyOrdersScanOrder"
        ],
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "on_error": [
            "DailyAlchemyOrdersScanOrder"
        ],
        "max_hit": 6,
        "post_delay": 800
    },
    "DailyAlchemyOrdersOpenAlchemy": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady",
                    "__DailyAlchemyOrdersDrawerIcon"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {}
            }
        },
        "next": [
            "DailyAlchemyOrdersScanOrder"
        ],
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "on_error": [
            "DailyAlchemyOrdersScanOrder"
        ],
        "max_hit": 6,
        "post_delay": 1000
    },
    "DailyAlchemyOrdersCollect": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyAlchemyOrdersPageReady",
                    "__DailyAlchemyOrdersCollectButton"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {},
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "post_delay": 1200,
        "max_hit": 3,
        "next": [
            "DailyAlchemyOrdersScanOrder"
        ],
        "on_error": [
            "DailyAlchemyOrdersScanOrder"
        ],
        "focus": {
            "Node.Action.Starting": "炼金：看到一键收取，点击中心；确认弹窗由统一入口处理（收取最多三次）。"
        }
    },
    "DailyAlchemyOrdersScanOrder": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "DailyAlchemyOrdersCloseDeliveryReward",
            "[JumpBack]CommonWaitLoading",
            "DailyAlchemyOrdersStartBlueProduction",
            "DailyAlchemyOrdersSelectMaximum",
            "DailyAlchemyOrdersSelectBlueRecipe",
            "DailyAlchemyOrdersOpenEmptySlot",
            "DailyAlchemyOrdersDeliverVisibleOrder",
            "DailyAlchemyOrdersCollect",
            "DailyAlchemyOrdersReturnMain",
            "DailyAlchemyOrdersOpenAlchemy",
            "DailyAlchemyOrdersOpenDrawer"
        ],
        "timeout": 12000,
        "max_hit": 100,
        "on_error": [
            "TkfmTaskFailure"
        ]
    },
    "DailyAlchemyOrdersDeliverVisibleOrder": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__DailyAlchemyOrdersPageReady",
                    "__DailyAlchemyOrdersDeliverable"
                ],
                "box_index": 1
            }
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "ClickRecognitionCenter",
                "custom_action_param": {},
                "target": true,
                "target_offset": [
                    67,
                    76,
                    0,
                    0
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": true,
            "timeout": 1500
        },
        "post_delay": 1200,
        "max_hit": 10,
        "next": [
            "DailyAlchemyOrdersScanOrder"
        ],
        "on_error": [
            "DailyAlchemyOrdersScanOrder"
        ],
        "focus": {
            "Node.Action.Starting": "炼金：看到可交付订单勾选标记，点击对应完整卡片；下一轮重新识别奖励或仍在的订单。"
        }
    },
    "DailyAlchemyOrdersAbortToMain": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "TkfmTaskFailure"
        ],
        "timeout": 1,
        "focus": {
            "Node.Action.Starting": "炼金：未知页面或操作次数耗尽，明确失败并交给通用恢复，不冒充完成。"
        }
    },
    "DailyAlchemyOrdersReturnMain": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "__DailyAlchemyOrdersPageReady",
                        "__DailyAlchemyOrdersRunningSlot1",
                        "__DailyAlchemyOrdersRunningSlot2",
                        "__DailyAlchemyOrdersRunningSlot3"
                    ],
                    "absent": [
                        "__DailyAlchemyOrdersDeliverable",
                        "__DailyAlchemyOrdersEmptySlot"
                    ]
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    40,
                    72
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                15,
                52,
                85,
                44
            ],
            "timeout": 1500
        },
        "post_delay": 800,
        "max_hit": 3,
        "next": [
            "DailyAlchemyOrdersFinishRouter"
        ],
        "on_error": [
            "DailyAlchemyOrdersFinishRouter"
        ],
        "focus": {
            "Node.Action.Starting": "炼金：三栏均已生产、没有可交付订单或弹窗，返回主页。"
        }
    },
    "DailyAlchemyOrdersDone": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ],
                "box_index": 0
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [],
        "focus": {
            "Node.Action.Succeeded": "炼金完成：可见订单已处理，空栏已补蓝宝石999个，并已回到主界面。"
        }
    },
    "__DailyAlchemyOrdersTitle": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "DailyAlchemyOrders/Title720.png",
                "roi": [
                    90,
                    130,
                    100,
                    55
                ],
                "threshold": 0.9
            }
        }
    },
    "__DailyAlchemyOrdersCount": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "^订单\\s*([0-7]\\s*/\\s*7|[0-9]\\s*/\\s*9)\\s*$"
                ],
                "roi": [
                    0,
                    840,
                    160,
                    65
                ]
            }
        }
    },
