{
    "DailyAlchemyOrdersStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "TkfmRunWithRecovery",
                "custom_action_param": {
                    "entry": "DailyAlchemyOrdersStartAttempt",
                    "label": "炼金订单"
                }
            }
        }
    },
    "DailyAlchemyOrdersStartAttempt": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "DailyAlchemyOrdersOpenDrawer",
            "[JumpBack]CommonCloseReward",
            "[JumpBack]CommonEnsureMain"
        ],
        "timeout": 10000
    },
    "DailyAlchemyOrdersOpenDrawer": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    35,
                    630
                ]
            }
        },
        "next": [
            "DailyAlchemyOrdersOpenAlchemy"
        ],
        "pre_wait_freezes": 300
    },
    "DailyAlchemyOrdersOpenAlchemy": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "派遣队1"
                ],
                "roi": [
                    0,
                    520,
                    120,
                    70
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    116,
                    510
                ]
            }
        },
        "post_wait_freezes": {
            "time": 700,
            "target": [
                0,
                0,
                0,
                0
            ]
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "DailyAlchemyOrdersCollect"
        ],
        "pre_wait_freezes": 300
    },
    "DailyAlchemyOrdersCollect": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "一键收取",
                    "键收取"
                ],
                "roi": [
                    390,
                    750,
                    210,
                    90
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_wait_freezes": {
            "time": 600,
            "target": [
                0,
                0,
                0,
                0
            ]
        },
        "next": [
            "[JumpBack]CommonCloseReward",
            "DailyAlchemyOrdersScanOrder"
        ],
        "pre_wait_freezes": 300
    },
    "DailyAlchemyOrdersScanOrder": {
        "next": [
            "[JumpBack]CommonCloseReward",
            "[JumpBack]CommonWaitLoading",
            "DailyAlchemyOrdersDeliverVisibleOrder",
            "DailyAlchemyOrdersVerifyComplete"
        ],
        "timeout": 5000,
        "on_error": [
            "DailyAlchemyOrdersAbortToMain"
        ]
    },
    "DailyAlchemyOrdersDeliverVisibleOrder": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    25,
                    940,
                    670,
                    70
                ],
                "method": 40,
                "lower": [
                    15,
                    80,
                    120
                ],
                "upper": [
                    45,
                    255,
                    255
                ],
                "count": 120,
                "connected": true,
                "order_by": "Horizontal"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    85,
                    1040
                ]
            }
        },
        "post_wait_freezes": {
            "time": 700,
            "target": [
                20,
                930,
                130,
                220
            ]
        },
        "next": [
            "DailyAlchemyOrdersAwaitDeliveryResult"
        ],
        "max_hit": 9,
        "pre_wait_freezes": 300,
        "on_error": [
            "DailyAlchemyOrdersAbortToMain"
        ]
    },
    "DailyAlchemyOrdersAbortToMain": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseReward",
            "CommonEnsureMain"
        ],
        "timeout": 15000
    },
    "DailyAlchemyOrdersReturnMain": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "__DailyAlchemyOrdersTitle",
                        "__DailyAlchemyOrdersCount",
                        "__DailyAlchemyOrdersCollectButton"
                    ],
                    "absent": [
                        "__DailyAlchemyOrdersDeliverable",
                        "__DailyAlchemyOrdersRewardPopup"
                    ]
                }
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    40,
                    72
                ]
            }
        },
        "next": [
            "DailyAlchemyOrdersDone"
        ],
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                15,
                52,
                85,
                44
            ],
            "timeout": 1500
        },
        "max_hit": 3
    },
    "DailyAlchemyOrdersDone": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMainObserve"
        ],
        "timeout": 1500,
        "on_error": [
            "DailyAlchemyOrdersReturnMain"
        ]
    },
    "__DailyAlchemyOrdersTitle": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "炼金"
                ],
                "roi": [
                    70,
                    120,
                    120,
                    70
                ]
            }
        }
    },
    "__DailyAlchemyOrdersCount": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "^订单\\s*([0-7]\\s*/\\s*7|[0-9]\\s*/\\s*9)\\s*$"
                ],
                "roi": [
                    0,
                    840,
                    160,
                    65
                ]
            }
        }
    },
    "__DailyAlchemyOrdersCollectButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "一键收取",
                    "键收取"
                ],
                "roi": [
                    390,
                    750,
                    210,
                    90
                ]
            }
        }
    },
    "__DailyAlchemyOrdersDeliverable": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    25,
                    940,
                    670,
                    70
                ],
                "method": 40,
                "lower": [
                    15,
                    80,
                    120
                ],
                "upper": [
                    45,
                    255,
                    255
                ],
                "count": 120,
                "connected": true,
                "order_by": "Horizontal"
            }
        }
    },
    "__DailyAlchemyOrdersRewardPopup": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "获得奖励|奖励已增加至仓库"
                ],
                "roi": [
                    200,
                    400,
                    330,
                    410
                ]
            }
        }
    },
    "DailyAlchemyOrdersVerifyComplete": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "TaskCompletionGuard",
                "custom_recognition_param": {
                    "required": [
                        "__DailyAlchemyOrdersTitle",
                        "__DailyAlchemyOrdersCount",
                        "__DailyAlchemyOrdersCollectButton"
                    ],
                    "absent": [
                        "__DailyAlchemyOrdersDeliverable",
                        "__DailyAlchemyOrdersRewardPopup"
                    ]
                }
            }
        },
        "post_delay": 500,
        "next": [
            "[JumpBack]CommonCloseReward",
            "[JumpBack]CommonWaitLoading",
            "DailyAlchemyOrdersDeliverVisibleOrder",
            "DailyAlchemyOrdersReturnMain"
        ],
        "timeout": 5000,
        "max_hit": 3,
        "on_error": [
            "DailyAlchemyOrdersAbortToMain"
        ]
    },
    "DailyAlchemyOrdersAwaitDeliveryResult": {
        "next": [
            "DailyAlchemyOrdersCloseDeliveryReward"
        ],
        "timeout": 3500,
        "on_error": [
            "DailyAlchemyOrdersDeliveryRetry"
        ]
    },
    "DailyAlchemyOrdersDeliverySucceeded": {
        "recognition": {
            "type": "DirectHit"
        },
        "post_delay": 400,
        "next": [
            "DailyAlchemyOrdersScanOrder"
        ]
    },
    "DailyAlchemyOrdersDeliveryRetry": {
        "recognition": {
            "type": "DirectHit"
        },
        "max_hit": 1,
        "next": [
            "DailyAlchemyOrdersDeliverVisibleOrder"
        ],
        "on_error": [
            "DailyAlchemyOrdersAbortToMain"
        ]
    },
    "DailyAlchemyOrdersCloseDeliveryReward": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "确定",
                    "确认"
                ],
                "roi": [
                    300,
                    700,
                    120,
                    80
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                300,
                700,
                120,
                80
            ],
            "timeout": 1500
        },
        "post_delay": 500,
        "next": [
            "DailyAlchemyOrdersDeliverySucceeded"
        ]
    }
}
